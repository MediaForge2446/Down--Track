<Window x:Class="DownTrack.WebSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DownTrack Setup" Height="420" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <!-- Card Container עם פינות מעוגלות וצללית עדינה -->
    <Border CornerRadius="16" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Top Header: Close & Language -->
                <RowDefinition Height="Auto"/>
                <!-- Center Hero & Progress -->
                <RowDefinition Height="*"/>
                <!-- Bottom Action -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Language Switcher & Close -->
            <Grid Grid.Row="0">
                <Button x:Name="BtnLang" HorizontalAlignment="Left" Content="עברית"
                        Background="#27272A" Foreground="#E4E4E7" BorderThickness="0"
                        Padding="10,4" FontSize="12" Cursor="Hand" Click="BtnLang_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button HorizontalAlignment="Right" Content="✕"
                        Background="Transparent" Foreground="#A1A1AA" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Center: Logo, Title, Progress Bar, Status -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
                <!-- App Purple D Icon -->
                <Border Width="64" Height="64" CornerRadius="16" Background="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="D" Foreground="White" FontSize="36" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>

                <TextBlock Text="DownTrack" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LblSubtitle" Text="מנהל ספריית המדיה שלך" FontSize="13" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <!-- Custom Modern Progress Bar -->
                <ProgressBar x:Name="PrgBar" Height="6" Maximum="100" Value="0"
                             Background="#27272A" Foreground="#7C3AED" BorderThickness="0" Margin="0,0,0,12"/>

                <TextBlock x:Name="LblStatus" Text="מתכונן להתקנה..." FontSize="12" Foreground="#D4D4D8" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bottom: Action Button (Launch / Retry) -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button x:Name="BtnAction" Content="הפעל את DownTrack"
                        Background="#7C3AED" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Height="40" FontSize="14" Cursor="Hand"
                        Visibility="Collapsed" Click="BtnAction_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>