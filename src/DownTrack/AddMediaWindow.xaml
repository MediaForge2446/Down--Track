<ui:FluentWindow x:Class="DownTrack.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="הוסף מדיה - DownTrack" Height="600" Width="800"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- תיבת הזנת קישור -->
            <RowDefinition Height="Auto"/>
            <!-- רשימת כרטיסי המדיה (תוצאות) -->
            <RowDefinition Height="*"/>
            <!-- כפתורי פעולה תחתונים -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Input Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" x:Name="TxtUrl"
                        PlaceholderText="הדבק כאן קישור לשיר או פלייליסט מיוטיוב..."
                        Icon="{ui:SymbolIcon Link24}"
                        KeyDown="TxtUrl_KeyDown"
                        Margin="0,0,8,0"/>

            <ui:Button Grid.Column="1" x:Name="BtnFetch"
                       Appearance="Primary"
                       Content="טען קישור"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Click="BtnFetch_Click"/>
        </Grid>

        <!-- Center: Cards List / Loading State -->
        <Grid Grid.Row="1">
            <!-- Progress Ring during fetch -->
            <StackPanel x:Name="PnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="שולף פרטי מדיה מיוטיוב..." Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Cards Container -->
            <ScrollViewer x:Name="ScrollItems" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Thumbnail -->
                                        <ColumnDefinition Width="140"/>
                                        <!-- Details & Name Edit -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Format & Quality Options -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Height="80" Background="#20000000">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Title Edit & Meta -->
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                    FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Duration, StringFormat='משך זמן: {0:mm\:ss}'}"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Actions: Format & Quality -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox SelectedIndex="{Binding SelectedFormat, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}" Width="90" Margin="0,0,8,0">
                                            <ComboBoxItem Content="MP3"/>
                                            <ComboBoxItem Content="MP4"/>
                                        </ComboBox>

                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary"
                                                   Click="BtnRemoveItem_Click" Tag="{Binding}" ToolTip="הסר פריט"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist Batch Action -->
            <ui:Button Grid.Column="0" x:Name="BtnApplyAll"
                       Appearance="Secondary"
                       Content="החל פורמט על כולם"
                       Click="BtnApplyAll_Click"
                       Visibility="Collapsed"/>

            <!-- Action Buttons -->
            <ui:Button Grid.Column="2" Content="ביטול" Click="BtnCancel_Click" Margin="0,0,8,0" Width="90"/>
            <ui:Button Grid.Column="3" x:Name="BtnDownloadAll" Appearance="Primary"
                       Content="הורד עכשיו" Click="BtnDownloadAll_Click" Width="120" IsEnabled="False"/>
        </Grid>
    </Grid>
</ui:FluentWindow>